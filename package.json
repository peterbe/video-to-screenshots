{
  "name": "video-to-screenshots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run ssg",
    "lint": "biome check --write --unsafe",
    "lint:check": "biome check",
    "preview": "vite preview",
    "prepare": "husky",
    "ssg": "bun run src/scripts/generate-static-pages.ts",
    "test": "bun run test:ssg && bun run test:playwright",
    "test:ssg": "bun test ./src/tests/ssg.test.ts",
    "test:playwright": "playwright test",
    "playwright:codegen": "playwright codegen",
    "postinstall": "bunx biome migrate --write"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "cheerio": "^1.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
